/// The `emery:adapter` contract: a source axis and a target axis, each
/// `metadata` and one judgment operation.
///
/// An adapter guest exports one axis interface. No resource type crosses
/// the contract. Dispatch carries plain values, routed by each call's
/// `adapter-id` first argument.
package emery:adapter@0.1.0;

/// The types both axes of the contract share.
///
/// Each axis interface declares its own records beside its operations, so
/// a guest of one axis binds nothing of the other. What both exchange is
/// declared here once.
interface types {
  /// The error an operation returns.
  variant error {
    /// The adapter refused its input.
    invalid-request(string),
    /// The adapter failed on its own account.
    internal(string),
  }

  /// The identity dispatch routes a call by: the name the loader registered
  /// the adapter's guest under. A declared guest is its bare name
  /// (`intent`), a local component its file stem (`custom` for
  /// `custom.wasm`), and a registry package its reference without the
  /// version (`emery:intent`).
  type adapter-id = string;
}

/// The source adapter contract: its records, `metadata`, and `extract`.
interface source {
  use types.{ adapter-id, error };

  /// The content a source is read from: a read-only view or an inline
  /// value. Never a revision-store path.
  variant content {
    /// The deployment-local path of the read-only view root.
    workspace(string),
    /// The inline value itself.
    value(string),
  }

  /// The input to one extraction: the source's name and its content. A
  /// source is value-in; it never reads the revision store.
  record input {
    /// The name the specification cites the source by: the operator's
    /// `[[source]] name`, or the adapter's name when omitted.
    name: string,
    /// The read-only view or inline value.
    content: content,
  }

  /// The kind of source an adapter reads. It is a fact about the artefact,
  /// so the adapter declares it in its metadata and the model never answers
  /// it. Kinds rank by authority, `intent` over `documentation` over
  /// `behaviour`, which decides a cross-source disagreement.
  enum source-kind {
    /// Operator directives. Highest authority.
    intent,
    /// Written specifications and documentation.
    documentation,
    /// Empirically observed behaviour. Lowest authority.
    behaviour
  }

  /// The closed taxonomy of claim kinds. A new kind changes the contract.
  enum claim-kind {
    intent,
    requirement,
    criterion,
    decision,
    section,
    diagram,
    contract,
    /// A runtime capture, carrying a `replay-digest` extra.
    example,
    excerpt,
    %type,
    call,
    region,
    container,
    leaf
  }

  /// The backing data of a claim's evidence.
  variant backing {
    /// A small, verbatim piece of data passed directly.
    payload(string),
    /// A pointer to a block of data in the filesystem.
    path(string),
  }

  /// A claim extracted from the source.
  record claim {
    /// The claim's kind from the closed taxonomy.
    kind: claim-kind,
    /// The stable claim identifier, a dotted kebab slug such as
    /// `password-reset.expiry`. Required when `kind` is `requirement`,
    /// `criterion`, or `example`; optional on other kinds.
    id: option<string>,
    /// The claim's anchor in the source: `<path>`, `<path>#L<n>`, or
    /// `<path>#L<start>-L<end>`.
    path: option<string>,
    /// A one-line summary of the claim's meaning, which synthesis merges
    /// related claims across sources by.
    synopsis: option<string>,
    /// The backing data of the claim's evidence.
    backing: option<backing>,
    /// The per-kind body fields the closed record does not model, such as
    /// `statement`, `criterion`, and `replay-digest`. Each pair is the
    /// field's name and its canonical JSON encoding. Synthesis reads them
    /// verbatim, so the contract conserves them.
    extras: list<tuple<string, string>>,
  }

  /// The claim set an extraction returns. The kind of source it was read
  /// from is the adapter's, reported by `metadata`, never carried here.
  record evidence {
    /// The claims extracted from the source.
    claims: list<claim>,
  }

  /// What a source adapter declares about itself, as compiled-in
  /// constants. Identity is the package reference and axis is the exported
  /// world, so the record carries the host version requirement and the
  /// kind of source alone.
  record adapter-metadata {
    /// The minimum `emery` version this adapter needs, as an exact semver
    /// like Cargo's `rust-version`. The host refuses the adapter when the
    /// running binary is older. Absent means no minimum.
    emery-version: option<string>,
    /// The kind of source this adapter reads, which ranks its evidence
    /// against other sources'.
    kind: source-kind,
  }

  /// Reports the adapter's metadata. The host asks once per run, after the
  /// load and before any extract. Effect-free and answerable from
  /// compiled-in constants: no model call, no filesystem access.
  metadata: func(id: adapter-id) -> adapter-metadata;

  /// Extracts the source's claim set, the one judgment operation. Returns
  /// `invalid-request` when the adapter refuses its input and `internal`
  /// when it fails on its own account.
  extract: async func(id: adapter-id, input: input) -> result<evidence, error>;
}

/// A source adapter component. The interface is imported as well as
/// exported, so one binding generation carries the caller side too.
world source-adapter {
  import source;
  export source;
}

/// The target adapter contract: its records, `metadata`, and `run`.
interface target {
  use types.{ adapter-id, error };

  /// How a merge resolves a conflict at a path a `merge-rule` matches,
  /// before the conflict is reported.
  enum merge-strategy {
    /// Both sides' lines kept, each once: declaration and import lists.
    union,
    /// The integrated tree's side kept whole, for the build to regenerate:
    /// lockfiles.
    ours,
    /// The slice's side kept whole.
    theirs,
  }

  /// One rule for merging a slice into the integrated tree: a glob over
  /// root-relative paths and the strategy for the paths it matches. The
  /// first rule that matches applies.
  record merge-rule {
    /// The glob, over paths relative to the tree root.
    paths: string,
    /// How a conflict at a matching path is resolved.
    strategy: merge-strategy,
  }

  /// What a target adapter declares about itself, as compiled-in
  /// constants: the host version requirement and its merge rules.
  record target-metadata {
    /// The minimum `emery` version this adapter needs, as an exact semver
    /// like Cargo's `rust-version`. The host refuses the adapter when the
    /// running binary is older. Absent means no minimum.
    emery-version: option<string>,
    /// The rules the engine merges every slice under, since the adapter
    /// alone knows which files its builds regenerate and which they
    /// extend. Empty leaves every conflict unresolved.
    merge-rules: list<merge-rule>,
  }

  /// One acceptance scenario of a requirement, as the specification
  /// drafts it.
  record scenario {
    /// The scenario's heading.
    name: string,
    /// The `GIVEN` conditions, one each; may be empty.
    given: list<string>,
    /// The `WHEN` trigger.
    when: string,
    /// The `THEN` outcome, `[unknown]` where the sources evidence none.
    then: string,
    /// The further `AND` outcomes, one each; may be empty.
    and: list<string>,
  }

  /// An HTTP route: a method, uppercase, and a path template led by `/`
  /// with each parameter spelled `{name}`.
  record route {
    /// The method: `GET`, `POST`, `PUT`, `PATCH`, `DELETE`, `HEAD`, or
    /// `OPTIONS`.
    method: string,
    /// The path template, `/orders/{id}/pay`.
    path: string,
  }

  /// What reaches a requirement: the surface the source registered its
  /// behaviour at. Which wire carries a message is the design's to say.
  variant trigger {
    /// An HTTP route.
    http(route),
    /// An inbound message by name: a broker topic, a socket event.
    message(string),
  }

  /// One requirement the slice builds, typed beside its rendering in
  /// `spec`, so an adapter reads its parts without parsing the Markdown.
  record requirement {
    /// The stable requirement identifier, `REQ-001`. A report's `covered`
    /// is held to these.
    id: string,
    /// The dotted subject, `orders.pay`, whose first segment is the stem.
    subject: string,
    /// The statement's paragraphs, in order; empty for a requirement in
    /// conflict.
    statement: list<string>,
    /// The acceptance scenarios, in the specification's order.
    scenarios: list<scenario>,
    /// What reaches the requirement, where the source's surface registered
    /// it; the specification's `Route:` or `Message:` line.
    trigger: option<trigger>,
  }

  /// One design type the slice owns: a data shape its code reads or
  /// produces, as the design carries it.
  record design-type {
    /// The type's key, as the plan entry names it.
    key: string,
    /// The source's signature, verbatim.
    signature: string,
  }

  /// One slice of the build plan, as `emery show` renders the revision it
  /// comes from. A target is value-in; it never reads the revision store.
  record slice {
    /// The slice's stable identifier, `SLICE-001`.
    id: string,
    /// The slice's drafted kebab-case name, which labels the build.
    name: string,
    /// The commit the lent tree sits on: the integrated head the slice
    /// builds over, so a worker elsewhere can materialise the same tree.
    base: string,
    /// The requirements the slice builds, typed, each one `spec` renders.
    /// A report's `covered` is held to their ids, so neither side reads
    /// them back out of the Markdown.
    requirements: list<requirement>,
    /// The design types the slice owns, each one `design` renders.
    types: list<design-type>,
    /// The plan's brief for the slice: the paragraphs a builder reads
    /// before taking it up.
    brief: list<string>,
    /// The specification cut to the slice: its preamble and the slice's
    /// requirements, as `emery show spec` renders them.
    spec: string,
    /// The whole design, as `emery show design` renders it.
    design: string,
    /// The slice's own plan entry: the requirements it builds, the design
    /// types it owns, the slices built before it, and its brief.
    plan: string,
  }

  /// What a build reports beyond the tree it wrote.
  record report {
    /// The requirement ids the build implemented, each one of the slice's.
    /// A requirement left out is uncovered; the report never says why.
    covered: list<string>,
    /// The files the build wrote or changed, as `/`-separated paths
    /// relative to the workspace root.
    written: list<string>,
  }

  /// What a verification of the integrated tree found.
  record verdict {
    /// Whether every check passed. Agrees with `failures`: `true` with
    /// none, `false` with at least one.
    passed: bool,
    /// Each check that failed, named with the tail of its output.
    failures: list<string>,
  }

  /// What the engine asks a target adapter to do in the lent tree.
  variant task {
    /// Scaffold the layout's initial files the tree lacks; a held file stands.
    /// Put once per tree the build lands in, before any slice, with no
    /// model turn expected: the engine seals what it finds as `Initialise`.
    init,
    /// Build one slice of the plan into the tree.
    build(slice),
    /// Run the checks over the integrated tree once a wave has merged into
    /// it, repair what they find, and answer a verdict.
    verify,
  }

  /// The answer to a task: `initialised` to `init`, `built` to `build`,
  /// `verified` to `verify`. Any other pairing is the adapter's defect.
  variant outcome {
    initialised,
    built(report),
    verified(verdict),
  }

  /// Reports the adapter's metadata. The host asks once per run, after the
  /// load and before any task. Effect-free and answerable from compiled-in
  /// constants: no model call, no filesystem access.
  metadata: func(id: adapter-id) -> target-metadata;

  /// Runs `task` in the writable tree at `workspace`, the one judgment
  /// operation. `workspace` is the deployment-local path of the tree root,
  /// which the adapter lends to its model for a build or a verify and
  /// scaffolds its layout into for an init. Returns `invalid-request` when the
  /// adapter refuses its input and `internal` when it fails on its own
  /// account.
  run: async func(id: adapter-id, workspace: string, task: task) -> result<outcome, error>;
}

/// A target adapter component. The interface is imported as well as
/// exported, so one binding generation carries the caller side too.
world target-adapter {
  import target;
  export target;
}
