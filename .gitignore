# Source directories that share the `target` name with Cargo's build dir;
# without these exceptions .gitignore would silently exclude them from commits.
!/examples/target/
!/examples/target/**
!/crates/adapter/src/target/
!/crates/adapter/src/target/**

/emery
docs/book/

# Stable, browsable quality-profile sandbox
quality/.sandbox/

# Operator-invoked local runs (eval harness + change example)
sandbox/
sandbox.lock

# Emery project state and integration-run scratch logs
.omnia/
stderr.log
stdout.log

# The root suites' stand-in for the adapters mount
/adapters/

# The live journey's mock target output
/build/
