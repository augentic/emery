{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "enabledManagers": ["github-actions", "custom.regex"],
  "packageRules": [
    {
      "matchPackageNames": ["augentic/toolkit"],
      "groupName": "augentic/toolkit",
      "commitMessageTopic": "augentic/toolkit",
      "prBodyNotes": [
        "Bump the toolkit pin in `mise.toml` and every `.github/workflows/` `uses:` reference in the same pull request."
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^augentic\\/(?!toolkit$)/"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["!augentic/toolkit"],
      "groupName": "github actions",
      "groupSlug": "actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": [
        "github\\.com/augentic/toolkit\\.git//mise/rust\\.toml\\?ref=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "augentic/toolkit",
      "datasourceTemplate": "github-tags"
    }
  ]
}
