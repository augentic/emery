{
  "name": "slides",
  "private": true,
  "scripts": {
    "dev": "slidev client.md --open",
    "dev:client": "slidev client.md --open",
    "dev:recommendations": "slidev recommendations.md --open",
    "dev:reference": "slidev technical-reference.md --open",
    "build": "slidev build client.md --out dist/client",
    "build:client": "slidev build client.md --out dist/client",
    "build:recommendations": "slidev build recommendations.md --out dist/recommendations",
    "build:reference": "slidev build technical-reference.md --out dist/reference",
    "export": "slidev export client.md",
    "export:client": "slidev export client.md",
    "export:recommendations": "slidev export recommendations.md",
    "export:reference": "slidev export technical-reference.md",
    "export:pptx": "slidev export client.md --format pptx",
    "export:client:pptx": "slidev export client.md --format pptx",
    "export:recommendations:pptx": "slidev export recommendations.md --format pptx",
    "export:reference:pptx": "slidev export technical-reference.md --format pptx"
  },
  "dependencies": {
    "@slidev/cli": "^51.0.0",
    "@slidev/theme-default": "latest",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.64.1"
  }
}
